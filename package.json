{
  "name": "@janispritzkau/tailwindcss-material-symbols-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "build": "pnpm run build-only && pnpm run type-check",
    "build-only": "pnpm --filter ./packages/tailwindcss-material-symbols build",
    "type-check": "tsc --build",
    "test": "pnpm --filter ./packages/tailwindcss-material-symbols test && pnpm test:scripts",
    "test:scripts": "tsx --test 'scripts/**/*.test.ts'",
    "test:example": "pnpm --filter ./examples/vite build && tsx ./scripts/check-example.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changelog": "git-cliff --output CHANGELOG.md",
    "publish:package": "pnpm --filter ./packages/tailwindcss-material-symbols publish --no-git-checks"
  },
  "devDependencies": {
    "@types/node": "^22.18.8",
    "git-cliff": "^2.14.2",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tsdown": "^0.23.2",
    "tsx": "^4.20.6",
    "typescript": "^6.0.3"
  }
}
