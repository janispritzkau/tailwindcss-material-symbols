{
  "name": "@janispritzkau/tailwindcss-material-symbols",
  "version": "1.0.0-rc.0",
  "description": "Easy-to-use, production-ready Material Symbols integration for Tailwind CSS with built-in font subsetting.",
  "keywords": [
    "material-symbols",
    "tailwindcss",
    "tailwind",
    "plugin",
    "vite",
    "icons",
    "subset-font"
  ],
  "homepage": "https://github.com/janispritzkau/tailwindcss-material-symbols",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/janispritzkau/tailwindcss-material-symbols.git",
    "directory": "packages/tailwindcss-material-symbols"
  },
  "bugs": {
    "url": "https://github.com/janispritzkau/tailwindcss-material-symbols/issues"
  },
  "author": "Janis Pritzkau <janispritzkau@gmail.com>",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "tailwindcss-material-symbols": "./bin/tailwindcss-material-symbols.js"
  },
  "exports": {
    ".": {
      "types": "./dist/v3/index.d.ts",
      "node": "./dist/v3/index.js",
      "style": "./src/index.css"
    },
    "./v3": {
      "types": "./dist/v3/index.d.ts",
      "default": "./dist/v3/index.js"
    },
    "./subset": {
      "types": "./dist/subset.d.ts",
      "import": "./dist/subset.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    }
  },
  "files": [
    "dist",
    "src/index.css",
    "src/generated/codepoints.css"
  ],
  "scripts": {
    "build": "pnpm run generate:codepoints && tsdown",
    "test": "pnpm run generate:codepoints && tsx --test 'test/**/*.test.ts'",
    "generate:codepoints": "tsx scripts/generate-codepoints.ts",
    "diff:codepoints": "tsx scripts/diff-codepoints.ts",
    "generate:fixtures": "tsx test/generate-fixtures.ts"
  },
  "peerDependencies": {
    "tailwindcss": "^3.4.17 || ^4.1.13",
    "vite": "^7.1.7 || ^8.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "dependencies": {
    "material-symbols": "0.48.2",
    "subset-font": "^2.4.0"
  },
  "devDependencies": {
    "@tailwindcss/node": "^4.3.3",
    "@types/fontkit": "^2.0.9",
    "@types/subset-font": "^2.3.0",
    "cac": "^7.1.0",
    "fontkit": "^2.0.4",
    "lightningcss": "^1.33.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.17",
    "vite": "^8.3.5"
  }
}
